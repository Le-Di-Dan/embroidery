# Dependencies
node_modules/

# Environment files (examples are kept)
.env*
!.env.example

# Build outputs
.next/
dist/
out/
*.tsbuildinfo

# Test outputs
coverage/

# E2E (Playwright) artifacts — never committed
test-results/
playwright-report/
blob-report/
.e2e-state/

# Turborepo
.turbo/

# SonarQube scanner
.scannerwork/

# OS / editor noise
.DS_Store
Thumbs.db

# Database backup artifacts (DB10). Dumps and their manifests are operational
# output, never source of truth, and a dump of this schema is high-sensitivity
# by classification — it must not reach the repository by accident.
.backups/
*.dump
*.manifest.json

# Playwright MCP scratch artifacts (screenshots/snapshots) — never committed
.playwright-mcp/
evidences/
