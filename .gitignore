# Dependencies
node_modules/

# Environment files (examples are kept)
# `.env-ignore` lists the names of secret-bearing variables (never their values)
# and is ignored for the same reason `.env` is: it is per-developer state. Its
# example IS committed, so the mechanism is discoverable on a fresh clone.
.env*
!.env.example
!.env-ignore.example

# Build outputs
.next/
dist/
out/
*.tsbuildinfo

# Test outputs
coverage/

# E2E (Playwright) artifacts — never committed
test-results/
playwright-report/
blob-report/
.e2e-state/

# Turborepo
.turbo/

# SonarQube scanner
.scannerwork/

# OS / editor noise
.DS_Store
Thumbs.db

# Database backup artifacts (DB10). Dumps and their manifests are operational
# output, never source of truth, and a dump of this schema is high-sensitivity
# by classification — it must not reach the repository by accident.
.backups/
*.dump
*.manifest.json

# Playwright MCP scratch artifacts (screenshots/snapshots) — never committed
.playwright-mcp/
evidences/

# `evidences/` above is unanchored, so it also swallowed `docs/implementation/
# evidences/`, which is not a scratch directory: `APP12-G03` §16 names
# `docs/implementation/evidences/APP12-G03-UAT-DATA-MANIFEST.md` as the canonical
# ownership and provenance authority for the persistent UAT dataset, and a
# document nobody else can read is not an authority. Screenshots stay ignored —
# only Markdown is tracked here.
!docs/implementation/evidences/
docs/implementation/evidences/*
!docs/implementation/evidences/*.md
