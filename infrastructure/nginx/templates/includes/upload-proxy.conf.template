# Route-scoped upload proxy seam (APP2-I01 §12, activated by APP2-B01 §21).
# ADR-APP2-001 §4.2c / §4.2f-6.
#
# ============================== ACTIVE ================================
# Included by exactly one location — `= /api/admin/assets/upload` on the
# Admin host — and by nothing else. It renders to
# /etc/nginx/conf.d/includes/upload-proxy.conf, which nginx.conf never loads
# on its own: its only include glob is `/etc/nginx/conf.d/*.conf`, one level
# up. So these directives apply to that one route and nowhere else.
#
# `tools/nginx-upload-seam.test.mjs` fails if that stops being true — if the
# seam becomes global, attaches to a second route, disables buffering
# anywhere else, or drifts from the approved values.
# ======================================================================

# Nginx buffers a whole request body to disk before contacting the upstream by
# default. That would defeat the streaming intake in ADR-APP2-001: the API
# would receive the body only after the gateway had already spooled all of it,
# so the server-side SHA-256 and the size guard could not run against a live
# stream, and a rejected upload would already have been written to gateway
# disk. Turning buffering off makes the client's stream the API's stream.
#
# Consequence B01 handles: with buffering off, the upstream sees a body that
# can stall or abort mid-flight, so the API owns its own read timeout and
# incremental size enforcement. The gateway is not the size authority.
proxy_request_buffering off;

# ---------------------------------------------------------------------------
# Approved route-scoped values (APP2-B01-G01 §C — Product Owner)
# ---------------------------------------------------------------------------
# 27 MiB / 28,311,552 bytes. This is a COARSE ENVELOPE ceiling, deliberately
# larger than the 25 MiB file limit so that multipart headers and boundaries
# cannot push a legitimate maximum-size image over the gateway's edge. It is
# NOT the file-size validator: the API counts the file part's bytes
# incrementally and rejects at exactly 26,214,400 with a 413 the client can
# act on. Raising this value does not raise the accepted image size.
client_max_body_size ${GATEWAY_UPLOAD_MAX_BODY_SIZE};

# 360s, strictly greater than the API's 300s hard upload duration, so the API
# always wins the race and returns its own timeout error instead of the client
# seeing a bare gateway 504 with nothing recorded.
proxy_read_timeout ${GATEWAY_UPLOAD_PROXY_TIMEOUT};
proxy_send_timeout ${GATEWAY_UPLOAD_PROXY_TIMEOUT};
