# The response headers every proxied surface carries (APP12-H01 §12).
#
# Extracted into an include for a structural reason, not for brevity: nginx
# `add_header` is inherited from the enclosing level ONLY while the current level
# declares none of its own. Every location that needed one header of its own —
# `/healthz` wanting `Cache-Control: no-store`, `/api/` wanting its own CSP —
# was therefore silently dropping the server-level set. Including this file at
# each such level restores them explicitly, and makes the next location that
# needs a header of its own fail visibly (a missing include) rather than
# silently.
#
# Deliberately NOT here:
#   Content-Security-Policy   — surface-specific. The two Next apps declare their
#                               own in next.config.ts (so the policy travels with
#                               the standalone image); /api/ declares the JSON one
#                               beside its own include.
#   Strict-Transport-Security — this gateway terminates plain HTTP. HSTS asserted
#                               over http:// is ignored by browsers and would be
#                               a claim with no evidence behind it. It belongs to
#                               the TLS edge (APP12-H02).
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header X-Frame-Options SAMEORIGIN always;
add_header X-Request-ID $effective_request_id always;
