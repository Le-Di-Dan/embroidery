# ============================================================================
# Embroidery Commerce Platform — development environment example
# Copy to `.env` and adjust locally. Never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Runtime environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Nginx Gateway (development edge gateway, D-036)
# ---------------------------------------------------------------------------
# Host port of the gateway — the default browser entrypoint. This PUBLIC port
# is also forwarded upstream as X-Forwarded-Port (Nginx itself listens on
# internal container port 8080). If 80 is taken, use e.g. 8085 and browse
# http://embroidery.local:8085
GATEWAY_HTTP_PORT=80
# Local hostnames routed by the gateway (add them to your hosts file,
# see docs/development/LOCAL_DEVELOPMENT.md)
STOREFRONT_HOST=embroidery.local
ADMIN_HOST=admin.embroidery.local
# Gateway request limits — these do NOT replace future application-level
# upload validation; they only bound what the proxy accepts.
GATEWAY_CLIENT_MAX_BODY_SIZE=20m
GATEWAY_PROXY_CONNECT_TIMEOUT=10s
GATEWAY_PROXY_READ_TIMEOUT=60s
GATEWAY_PROXY_SEND_TIMEOUT=60s
# Route-scoped values for POST /api/admin/assets/upload only (APP2-B01).
# The 27m ceiling is a coarse multipart-envelope bound, NOT the image size
# limit: the API enforces exactly 26,214,400 bytes on the file part itself.
# The timeout must stay strictly greater than the API's 300s hard duration.
GATEWAY_UPLOAD_MAX_BODY_SIZE=27m
GATEWAY_UPLOAD_PROXY_TIMEOUT=360s

# ---------------------------------------------------------------------------
# Storefront (Next.js)
# ---------------------------------------------------------------------------
# Direct host port for the storefront (debug overlay only)
STOREFRONT_PORT=3000
# Same-origin API base path used by the BROWSER through the gateway.
# Public (bundled into the client); must never contain an internal hostname.
NEXT_PUBLIC_API_BASE_PATH=/api
# Internal API base URL used by SERVER-side code (Server Components).
# Server-only: no NEXT_PUBLIC_ prefix, never exposed to the client bundle.
# Inside Docker Compose: http://api:4000/api ; for local `pnpm dev` with the
# debug overlay: http://localhost:4000/api
INTERNAL_API_BASE_URL=http://api:4000/api

# The two external contact channels shown in the Storefront footer's `Kết nối`
# group (APP10-I01; BR-018 and D-015 lock them to simple external links — there
# is no chatbot, provider SDK, webhook or message synchronization anywhere in
# this platform, and these values buy none).
#
# Each must be an ABSOLUTE http(s) URL, e.g. https://zalo.me/<oa-or-number> and
# https://m.me/<page>. They are PUBLIC: every visitor reads them in the page
# source, so neither is a credential and neither belongs in `.env-ignore` —
# marking a customer-visible fact as a secret would be false. Never put a token,
# access key, provider app secret or customer identifier in either value; the
# footer appends nothing to them and there is no server-side provider
# authentication to carry.
#
# Both are OPTIONAL and independent. A value that is unset, blank or not a valid
# absolute http(s) URL simply omits that one CTA; with neither usable the whole
# `Kết nối` group disappears and the footer returns to its pre-APP10 layout. A
# customer is never shown a disabled button or a configuration error.
NEXT_PUBLIC_ZALO_CONTACT_URL=
NEXT_PUBLIC_MESSENGER_CONTACT_URL=

# ---------------------------------------------------------------------------
# Admin (Next.js)
# ---------------------------------------------------------------------------
# Direct host port for the admin application (debug overlay only)
ADMIN_PORT=3001

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
# Container port for the business API; also the direct host port in the
# debug overlay. Routes use the global prefix /api (e.g. GET /api/health).
API_PORT=4000

# Swagger UI exposure (APP0-B01). Served at /api/docs through the gateway.
# Unset defaults to enabled in development/test and DISABLED in production;
# an explicit "true"/"false" always wins. Never enable it in production without
# a deliberate decision — it is unauthenticated.
# API_DOCS_ENABLED=true

# Structured logging (APP0-B05). Level is one of debug|info|warn|error; unset
# defaults to `debug` outside production and `info` in production. An invalid
# value fails startup rather than falling back silently.
# LOG_LEVEL=info
# Include a bounded, redacted stack on internal-error logs. Unset defaults to
# enabled outside production and DISABLED in production, so a stack never
# reaches a production log by default.
# LOG_STACK_ENABLED=false

# Staff authentication & sessions (APP1-B01, ADR-APP1-001). Unset values fall
# back to the ADR defaults below; production MUST set STAFF_SESSION_COOKIE_SECURE
# to true (the __Host- session cookie requires Secure) or startup fails fast.
# STAFF_SESSION_COOKIE_SECURE=false
# STAFF_SESSION_IDLE_TIMEOUT_MINUTES=30
# STAFF_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# STAFF_PASSWORD_MIN_LENGTH=12
# In-process login rate limits (transient; reset on restart, not shared across
# replicas — distributed limiting is APP12).
# STAFF_LOGIN_RATE_LIMIT_IDENTIFIER_MAX=5
# STAFF_LOGIN_RATE_LIMIT_IDENTIFIER_WINDOW_MINUTES=15
# STAFF_LOGIN_RATE_LIMIT_IP_MAX=20
# STAFF_LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=15
# STAFF_LOGIN_RATE_LIMIT_GLOBAL_MAX=100
# STAFF_LOGIN_RATE_LIMIT_GLOBAL_WINDOW_MINUTES=5
# Comma-separated Origin allowlist for staff session mutations (login/logout).
# A browser cross-site request from any other origin is rejected (CSRF defence).
STAFF_ALLOWED_ORIGINS=http://admin.embroidery.local

# Staff bootstrap (APP1-A01-C1). Consumed by the one-shot `staff-bootstrap`
# Compose service and the `pnpm --filter @embroidery/api staff:bootstrap` CLI;
# never read by normal API startup. Development: all three are REQUIRED — a
# missing value fails the bootstrap service and keeps the stack un-ready (so the
# login UI is never available without an admin to log in as). Production: all
# three are OPTIONAL — missing values skip bootstrap (exit 0) and mutate nothing.
# Never commit a real password; leave it blank here and supply it via `.env` or
# an approved secret channel, never on the command line.
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_PASSWORD=
STAFF_BOOTSTRAP_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Anonymous Design Session credentials (APP3-B06A / APP3-B07, IMP-D043 PO-02)
# ---------------------------------------------------------------------------
# The pepper keying the HMAC-SHA-256 over every Design Session secret. REQUIRED
# in every environment: the API refuses to start without it and there is no
# unpeppered fallback, because a peppered HMAC with an empty key verifies
# exactly like an unpeppered one. Minimum 32 characters.
#
# Rotating it invalidates every live session at once — every stored digest was
# computed under the old value — so treat it as a long-lived secret, not a knob.
# Never commit a real value; leave it blank here and supply it via `.env` or an
# approved secret channel, never on the command line.
DESIGN_SESSION_SECRET_PEPPER=

# Exact browser origins allowed to create or mutate a Design Session. Comma
# separated, `scheme://host[:port]`, no trailing slash. An empty list allows
# nothing: unlike the staff policy, a missing or unlisted Origin always fails
# (IMP-D043 PO-05), because the session cookie is SameSite=Lax.
DESIGN_SESSION_ALLOWED_ORIGINS=http://embroidery.local

# `Secure` on the session cookie. Defaults to true in production, where the
# `__Host-` prefix makes it mandatory; may be false only over plain-HTTP dev.
# DESIGN_SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Customer verification, secure links and notification delivery
# (APP4-G01, ADR-APP4-001 / IMP-D049)
# ---------------------------------------------------------------------------
# Three DISTINCT values. Two are HMAC peppers keying a digest; the third is an
# AES-256-GCM encryption key. They must never share a value: rotating a pepper
# invalidates every stored digest, while rotating the envelope key makes every
# un-delivered envelope unopenable — one value would couple two unrelated
# outages. Never commit a real value; leave these blank here and supply them via
# `.env` or an approved secret channel, never on the command line.
#
# Peppers for the verification code and the secure-link token digests. Minimum
# 32 characters each, no unpeppered fallback (a peppered HMAC with an empty key
# verifies exactly like an unpeppered one). Consumed from APP4-P01 onward.
VERIFICATION_CODE_SECRET_PEPPER=
SECURE_LINK_TOKEN_SECRET_PEPPER=

# The AES-256-GCM key sealing the transient delivery envelope that carries a raw
# code or token from the API to the notification worker. base64-encoded and
# EXACTLY 32 bytes once decoded. There is no default and no fallback: any
# runtime path that issues or delivers an encrypted envelope fails closed
# without it, because a process that cannot seal must not issue a secret it can
# never deliver. Never logged, in either encoded or decoded form. Consumed from
# APP4-B01 onward.
NOTIFICATION_DELIVERY_ENVELOPE_KEY=

# The canonical PUBLIC BROWSER ORIGIN customers use to reach the Storefront —
# scheme + host (+ port), e.g. http://embroidery.local. It is the authority for
# composing absolute secure links, `<origin>/truy-cap#t=<token>` (APP4-B05,
# ADR-APP4-001 §11), and it is NOT any of the four values that resemble it:
# STOREFRONT_HOST is a bare gateway hostname, INTERNAL_API_BASE_URL is the API's
# address on the compose network, and DESIGN_SESSION_ALLOWED_ORIGINS /
# STAFF_ALLOWED_ORIGINS are CSRF allowlists owned by other capabilities.
#
# No path, query, fragment or credentials; no default and no fallback. A wrong
# origin does not fail visibly — it lands a customer's token on another host —
# so an unset value fails closed at the rendering boundary and the delivery
# retries. Verification-code delivery never reads it.
#
# TWO consumers, one value. The worker composes secure links with it (APP4-B05
# onward). The Storefront server reads the SAME variable for its technical SEO
# surface (APP11-S04): metadataBase, every canonical URL, the sitemap URL in
# robots.txt and every URL in sitemap.xml. That is deliberate — a canonical tag
# and a secure link must name one address, and a second variable is how they
# start disagreeing. It stays server-side in both: no NEXT_PUBLIC_ twin exists,
# because no client code needs it. Unset, the Storefront's SEO routes fail
# rather than publishing a guessed origin.
#
# Left blank here on purpose. The DEVELOPMENT Compose file supplies the canonical
# local origin (http://embroidery.local) as a tracked default, so an ordinary
# `pnpm docker:dev:up` works without this being set (APP12-H02 §13). Set it here
# only when your gateway is not on port 80 — an origin missing the port names an
# address the browser cannot reach — or when you are running a non-default host.
# Staging and production receive it through tracked deployment configuration
# (infrastructure/kubernetes/overlays/*), where an empty value fails the release
# preflight rather than falling back to anything.
STOREFRONT_PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Customer notification transport (APP12-N01.B01)
# ---------------------------------------------------------------------------
# Which transport the notification worker actually sends over.
#
#   SMTP       production-capable email delivery
#   RECORDING  captured in process memory and delivered to NOBODY
#
# There is no default: the variable must be stated. APP12-U01 found the release
# blocker this closes — the worker was wired to the recording adapter
# unconditionally, so every verification code "delivered" successfully into an
# array that died with the process and no real customer could ever order. A
# default would reintroduce exactly that failure one environment lower.
#
# RECORDING is REFUSED when NODE_ENV is production or staging. It is for
# isolated tests and local work only.
NOTIFICATION_TRANSPORT=RECORDING

# SMTP settings, required when NOTIFICATION_TRANSPORT=SMTP. Deliberately plain
# SMTP and provider agnostic: a free SMTP-capable account today and a
# transactional provider later are the same configuration change and no code
# change. No vendor is named anywhere in the application.
#
# SMTP_SECURE=true means implicit TLS on connect (port 465). Left false, the
# session starts plain and upgrades with STARTTLS.
#
# SMTP_REQUIRE_TLS refuses to send at all over an unencrypted connection. It
# defaults to true and CANNOT be turned off when NODE_ENV is production or
# staging — without it a relay that simply does not advertise STARTTLS receives
# the account password in the clear. The only reason it is settable is the local
# SMTP capture listener the acceptance test speaks to.
#
# SMTP_PASSWORD is a credential: never commit a real value, never log it, never
# pass it on a command line. Read .env-ignore before using it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# The envelope sender every customer message is signed with. The address must be
# a single bare address — no display name, which is EMAIL_FROM_NAME's job — and
# is validated at startup so a placeholder cannot reach a customer's inbox.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Nét Thêu

# ---------------------------------------------------------------------------
# Merchant bank account for deposits (APP7-G01 §3, APP7-B03)
# ---------------------------------------------------------------------------
# The ONE account APP7 deposits are transferred to. Server-controlled sensitive
# OPERATIONAL CONFIGURATION — not credentials: every value below is printed on
# the customer's own deposit screen and encoded into the bank-transfer QR they
# scan. None of the four names matches the CLAUDE.md §8a protected pattern, and
# none may be renamed into it: marking a customer-visible fact as a secret would
# be false. They are deliberately absent from `.env-ignore`.
#
# There is no bank API credential in this MVP. No API key, merchant secret,
# webhook secret, provider token or signing key exists — payment verification is
# a manual Admin decision (PO-APP7-001), not a provider integration.
#
# All four are REQUIRED and fail fast at module composition: there is no default
# and no development shortcut, because a deposit surface with a partly-configured
# account would send a customer's money to the wrong place. The placeholders
# below are structurally valid and intentionally not a real account; production
# values are provisioned separately and must never appear in this repository.
#
# The NAPAS acquirer id of the receiving bank — exactly six digits. This is what
# the QR encodes to name the bank; it is a public bank identifier.
PAYMENT_MERCHANT_BANK_BIN=970000
# The receiving account number — 6 to 19 digits.
PAYMENT_MERCHANT_ACCOUNT_NUMBER=0000000000
# The account holder exactly as the bank shows it, so the customer can check it.
PAYMENT_MERCHANT_ACCOUNT_NAME=PLACEHOLDER ACCOUNT NAME
# The human bank name shown beside the account in the deposit instructions.
PAYMENT_MERCHANT_BANK_DISPLAY_NAME=Placeholder Bank

# ---------------------------------------------------------------------------
# Worker (NestJS application context)
# ---------------------------------------------------------------------------
# No worker-specific configuration is required yet.
# Queue/broker configuration is an open decision (see docs/12-DECISION-LOG.md).

# ---------------------------------------------------------------------------
# PostgreSQL (development container)
# ---------------------------------------------------------------------------
# Development-only credentials. Production credentials are provisioned
# separately and must never appear in this repository.
#
# Engine is pinned to postgres:16.14-alpine and initialised with locale C /
# encoding UTF8 (ADR-DB1-001, DEV-DB6-001). initdb runs only once per volume:
# if you created the volume before that setting existed, reset it with
#   pnpm db:reset
# See docs/database/DB6_MULTI_MACHINE_WORKFLOW.md.
POSTGRES_HOST=localhost
# Host port for the database. 5432 is the default; if it is already taken on
# your machine (a local PostgreSQL service is the usual cause), pick another
# free port here — e.g. 5433 — and keep DATABASE_URL below in sync.
POSTGRES_PORT=5432
POSTGRES_USER=embroidery
POSTGRES_PASSWORD=embroidery_dev_password
POSTGRES_DB=embroidery

# Connection string used by the API, the worker and drizzle-kit. It must agree
# with the discrete POSTGRES_* values above; startup validation fails fast if a
# required part is missing. Never log this value un-redacted.
DATABASE_URL=postgres://embroidery:embroidery_dev_password@localhost:5432/embroidery

# Connection pool bounds (per application process).
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Statement/lock guards. lock_timeout keeps a contended row lock from parking a
# request indefinitely; it surfaces as SQLSTATE 55P03 for the caller to retry.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000

# SSL for the database connection. Disabled for the local Docker service;
# production must enable it (validation rejects `disable` when NODE_ENV is
# production).
DATABASE_SSL_MODE=disable

# Expected PostgreSQL major version. Startup validation compares this against
# the connected server and fails fast on a mismatch, so a stray container or a
# stale volume is caught before any query runs.
DATABASE_EXPECTED_MAJOR=16

# ---------------------------------------------------------------------------
# Object storage (development MinIO container, ADR-APP2-001 / APP2-I01)
# ---------------------------------------------------------------------------
# S3-compatible storage for private originals and derivatives. Local values
# only — production credentials are provisioned separately and must never
# appear in this repository. Objects are always served through the API; there
# is no public bucket and no permanent public object URL.
#
# Only `s3` is supported. MinIO is reached over the same S3 API with a custom
# endpoint and path-style addressing, so it is not a separate provider.
OBJECT_STORAGE_PROVIDER=s3
# Compose network address of the development MinIO service. The service
# publishes no host port; use `http://127.0.0.1:<port>` only if you add one
# locally. Required in development — without it the SDK would silently address
# real AWS S3 instead of the container.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Region is required by the SDK signer even against MinIO, which ignores it.
OBJECT_STORAGE_REGION=us-east-1
# Path-style addressing (http://host/bucket/key). Required for MinIO: the
# virtual-host style AWS uses would need per-bucket DNS. Strict boolean —
# exactly `true` or `false`, nothing else is accepted.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Development-only credentials; they also seed MINIO_ROOT_USER/PASSWORD on the
# container. Set BOTH or NEITHER: leaving both unset falls back to the AWS
# default credential provider chain (the production path), while setting only
# one fails startup rather than silently reaching an unintended account.
OBJECT_STORAGE_ACCESS_KEY_ID=embroidery_minio_dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=embroidery_minio_dev_password
# Two separate private buckets — originals and derivatives are governed
# separately (retention, access), so they must be distinct names. Both the API
# and the worker verify (or create) them at startup through the same
# `ensurePrivateBuckets` operation (APP2-I03): the API does not listen and the
# worker does not claim a job until that succeeds, so these values are startup
# requirements for both processes, not upload-time ones.
OBJECT_STORAGE_ORIGINALS_BUCKET=embroidery-dev-originals
OBJECT_STORAGE_DERIVATIVES_BUCKET=embroidery-dev-derivatives

# ---------------------------------------------------------------------------
# SonarQube (development container, Compose profile "quality")
# ---------------------------------------------------------------------------
# Host port for the SonarQube UI
SONARQUBE_PORT=9000
# Dedicated database for the SonarQube service
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=sonar_dev_password
SONARQUBE_DB_NAME=sonar
# Scanner authentication token — generate one in the SonarQube UI.
# Keep it only in your local .env; never commit it.
SONAR_TOKEN=
# URL of the SonarQube server used by the scanner
SONAR_HOST_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Wave-2 custom embroidery release control (APP12-G02)
# ---------------------------------------------------------------------------
# The ONE server-side release-control variable, read by the API and by the
# Storefront with identical semantics. The product ships in two waves
# (docs/implementation/APP12-RELEASE-WAVE-AUTHORITY.md): Wave 1 is Ready-Made
# direct commerce plus public content, SEO and the shared primitives it needs;
# Wave 2 is ALL custom embroidery — the Design Studio, custom request intake,
# quotation, design review, the custom deposit/remaining payment surfaces and
# the custom fulfilment customer surfaces. Every one of those is built; this
# variable decides whether customers may reach them.
#
# Enforced in two independent places, because a blocked route in front of a live
# API is not blocked: seven Storefront routes are refused by the route gate, and
# 31 public API operations are refused by the operation gate.
#
#   true      -> Wave-2 custom embroidery released
#   false     -> withheld
#   unset     -> withheld   (the canonical default and the production default)
#   empty     -> withheld
#   anything  -> withheld   (fail closed; neither process refuses to start)
#
# Only lowercase `true` releases it: `1`, `yes`, `on` and `TRUE` are not
# accepted, because a gate that guesses at intent is a gate a typo can open.
#
# NOT a secret and NOT a credential — it holds no value worth protecting and its
# state is inferable by anyone who requests a withheld route. It is still read
# server-side only: there is deliberately no NEXT_PUBLIC_ twin, because a
# release gate the browser can read is a release gate the browser can be told to
# ignore. There is also deliberately no second variable and no per-surface alias
# (no ENABLE_EDITOR, no ENABLE_CUSTOM_REQUESTS, no CUSTOM_FLOW_ENABLED): one
# capability, one release authority.
CUSTOM_EMBROIDERY_RELEASE_ENABLED=false
