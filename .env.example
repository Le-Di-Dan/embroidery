# ============================================================================
# Embroidery Commerce Platform — development environment example
# Copy to `.env` and adjust locally. Never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Runtime environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Nginx Gateway (development edge gateway, D-036)
# ---------------------------------------------------------------------------
# Host port of the gateway — the default browser entrypoint. This PUBLIC port
# is also forwarded upstream as X-Forwarded-Port (Nginx itself listens on
# internal container port 8080). If 80 is taken, use e.g. 8085 and browse
# http://embroidery.local:8085
GATEWAY_HTTP_PORT=80
# Local hostnames routed by the gateway (add them to your hosts file,
# see docs/development/LOCAL_DEVELOPMENT.md)
STOREFRONT_HOST=embroidery.local
ADMIN_HOST=admin.embroidery.local
# Gateway request limits — these do NOT replace future application-level
# upload validation; they only bound what the proxy accepts.
GATEWAY_CLIENT_MAX_BODY_SIZE=20m
GATEWAY_PROXY_CONNECT_TIMEOUT=10s
GATEWAY_PROXY_READ_TIMEOUT=60s
GATEWAY_PROXY_SEND_TIMEOUT=60s
# Route-scoped values for POST /api/admin/assets/upload only (APP2-B01).
# The 27m ceiling is a coarse multipart-envelope bound, NOT the image size
# limit: the API enforces exactly 26,214,400 bytes on the file part itself.
# The timeout must stay strictly greater than the API's 300s hard duration.
GATEWAY_UPLOAD_MAX_BODY_SIZE=27m
GATEWAY_UPLOAD_PROXY_TIMEOUT=360s

# ---------------------------------------------------------------------------
# Storefront (Next.js)
# ---------------------------------------------------------------------------
# Direct host port for the storefront (debug overlay only)
STOREFRONT_PORT=3000
# Same-origin API base path used by the BROWSER through the gateway.
# Public (bundled into the client); must never contain an internal hostname.
NEXT_PUBLIC_API_BASE_PATH=/api
# Internal API base URL used by SERVER-side code (Server Components).
# Server-only: no NEXT_PUBLIC_ prefix, never exposed to the client bundle.
# Inside Docker Compose: http://api:4000/api ; for local `pnpm dev` with the
# debug overlay: http://localhost:4000/api
INTERNAL_API_BASE_URL=http://api:4000/api

# ---------------------------------------------------------------------------
# Admin (Next.js)
# ---------------------------------------------------------------------------
# Direct host port for the admin application (debug overlay only)
ADMIN_PORT=3001

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
# Container port for the business API; also the direct host port in the
# debug overlay. Routes use the global prefix /api (e.g. GET /api/health).
API_PORT=4000

# Swagger UI exposure (APP0-B01). Served at /api/docs through the gateway.
# Unset defaults to enabled in development/test and DISABLED in production;
# an explicit "true"/"false" always wins. Never enable it in production without
# a deliberate decision — it is unauthenticated.
# API_DOCS_ENABLED=true

# Structured logging (APP0-B05). Level is one of debug|info|warn|error; unset
# defaults to `debug` outside production and `info` in production. An invalid
# value fails startup rather than falling back silently.
# LOG_LEVEL=info
# Include a bounded, redacted stack on internal-error logs. Unset defaults to
# enabled outside production and DISABLED in production, so a stack never
# reaches a production log by default.
# LOG_STACK_ENABLED=false

# Staff authentication & sessions (APP1-B01, ADR-APP1-001). Unset values fall
# back to the ADR defaults below; production MUST set STAFF_SESSION_COOKIE_SECURE
# to true (the __Host- session cookie requires Secure) or startup fails fast.
# STAFF_SESSION_COOKIE_SECURE=false
# STAFF_SESSION_IDLE_TIMEOUT_MINUTES=30
# STAFF_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# STAFF_PASSWORD_MIN_LENGTH=12
# In-process login rate limits (transient; reset on restart, not shared across
# replicas — distributed limiting is APP12).
# STAFF_LOGIN_RATE_LIMIT_IDENTIFIER_MAX=5
# STAFF_LOGIN_RATE_LIMIT_IDENTIFIER_WINDOW_MINUTES=15
# STAFF_LOGIN_RATE_LIMIT_IP_MAX=20
# STAFF_LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=15
# STAFF_LOGIN_RATE_LIMIT_GLOBAL_MAX=100
# STAFF_LOGIN_RATE_LIMIT_GLOBAL_WINDOW_MINUTES=5
# Comma-separated Origin allowlist for staff session mutations (login/logout).
# A browser cross-site request from any other origin is rejected (CSRF defence).
STAFF_ALLOWED_ORIGINS=http://admin.embroidery.local

# Staff bootstrap (APP1-A01-C1). Consumed by the one-shot `staff-bootstrap`
# Compose service and the `pnpm --filter @embroidery/api staff:bootstrap` CLI;
# never read by normal API startup. Development: all three are REQUIRED — a
# missing value fails the bootstrap service and keeps the stack un-ready (so the
# login UI is never available without an admin to log in as). Production: all
# three are OPTIONAL — missing values skip bootstrap (exit 0) and mutate nothing.
# Never commit a real password; leave it blank here and supply it via `.env` or
# an approved secret channel, never on the command line.
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_PASSWORD=
STAFF_BOOTSTRAP_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Worker (NestJS application context)
# ---------------------------------------------------------------------------
# No worker-specific configuration is required yet.
# Queue/broker configuration is an open decision (see docs/12-DECISION-LOG.md).

# ---------------------------------------------------------------------------
# PostgreSQL (development container)
# ---------------------------------------------------------------------------
# Development-only credentials. Production credentials are provisioned
# separately and must never appear in this repository.
#
# Engine is pinned to postgres:16.14-alpine and initialised with locale C /
# encoding UTF8 (ADR-DB1-001, DEV-DB6-001). initdb runs only once per volume:
# if you created the volume before that setting existed, reset it with
#   pnpm db:reset
# See docs/database/DB6_MULTI_MACHINE_WORKFLOW.md.
POSTGRES_HOST=localhost
# Host port for the database. 5432 is the default; if it is already taken on
# your machine (a local PostgreSQL service is the usual cause), pick another
# free port here — e.g. 5433 — and keep DATABASE_URL below in sync.
POSTGRES_PORT=5432
POSTGRES_USER=embroidery
POSTGRES_PASSWORD=embroidery_dev_password
POSTGRES_DB=embroidery

# Connection string used by the API, the worker and drizzle-kit. It must agree
# with the discrete POSTGRES_* values above; startup validation fails fast if a
# required part is missing. Never log this value un-redacted.
DATABASE_URL=postgres://embroidery:embroidery_dev_password@localhost:5432/embroidery

# Connection pool bounds (per application process).
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Statement/lock guards. lock_timeout keeps a contended row lock from parking a
# request indefinitely; it surfaces as SQLSTATE 55P03 for the caller to retry.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000

# SSL for the database connection. Disabled for the local Docker service;
# production must enable it (validation rejects `disable` when NODE_ENV is
# production).
DATABASE_SSL_MODE=disable

# Expected PostgreSQL major version. Startup validation compares this against
# the connected server and fails fast on a mismatch, so a stray container or a
# stale volume is caught before any query runs.
DATABASE_EXPECTED_MAJOR=16

# ---------------------------------------------------------------------------
# Object storage (development MinIO container, ADR-APP2-001 / APP2-I01)
# ---------------------------------------------------------------------------
# S3-compatible storage for private originals and derivatives. Local values
# only — production credentials are provisioned separately and must never
# appear in this repository. Objects are always served through the API; there
# is no public bucket and no permanent public object URL.
#
# Only `s3` is supported. MinIO is reached over the same S3 API with a custom
# endpoint and path-style addressing, so it is not a separate provider.
OBJECT_STORAGE_PROVIDER=s3
# Compose network address of the development MinIO service. The service
# publishes no host port; use `http://127.0.0.1:<port>` only if you add one
# locally. Required in development — without it the SDK would silently address
# real AWS S3 instead of the container.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Region is required by the SDK signer even against MinIO, which ignores it.
OBJECT_STORAGE_REGION=us-east-1
# Path-style addressing (http://host/bucket/key). Required for MinIO: the
# virtual-host style AWS uses would need per-bucket DNS. Strict boolean —
# exactly `true` or `false`, nothing else is accepted.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Development-only credentials; they also seed MINIO_ROOT_USER/PASSWORD on the
# container. Set BOTH or NEITHER: leaving both unset falls back to the AWS
# default credential provider chain (the production path), while setting only
# one fails startup rather than silently reaching an unintended account.
OBJECT_STORAGE_ACCESS_KEY_ID=embroidery_minio_dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=embroidery_minio_dev_password
# Two separate private buckets — originals and derivatives are governed
# separately (retention, access), so they must be distinct names. Both the API
# and the worker verify (or create) them at startup through the same
# `ensurePrivateBuckets` operation (APP2-I03): the API does not listen and the
# worker does not claim a job until that succeeds, so these values are startup
# requirements for both processes, not upload-time ones.
OBJECT_STORAGE_ORIGINALS_BUCKET=embroidery-dev-originals
OBJECT_STORAGE_DERIVATIVES_BUCKET=embroidery-dev-derivatives

# ---------------------------------------------------------------------------
# SonarQube (development container, Compose profile "quality")
# ---------------------------------------------------------------------------
# Host port for the SonarQube UI
SONARQUBE_PORT=9000
# Dedicated database for the SonarQube service
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=sonar_dev_password
SONARQUBE_DB_NAME=sonar
# Scanner authentication token — generate one in the SonarQube UI.
# Keep it only in your local .env; never commit it.
SONAR_TOKEN=
# URL of the SonarQube server used by the scanner
SONAR_HOST_URL=http://localhost:9000
