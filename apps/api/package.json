{
  "name": "@embroidery/api",
  "version": "0.1.0",
  "private": true,
  "description": "Embroidery Commerce business API (NestJS modular monolith)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:asset-intake": "jest --config jest.asset-intake.config.mjs",
    "clean": "rimraf dist coverage",
    "bench": "jest --config jest.bench.config.mjs --runInBand",
    "openapi:generate": "nest build && node dist/openapi/cli/generate-openapi.js",
    "openapi:check": "nest build && node dist/openapi/cli/check-openapi.js",
    "staff:bootstrap": "nest build && node dist/cli/staff-bootstrap.js"
  },
  "dependencies": {
    "@embroidery/contracts": "workspace:*",
    "@embroidery/database": "workspace:*",
    "@embroidery/design-document": "workspace:*",
    "@embroidery/design-engine": "workspace:*",
    "@embroidery/domain-types": "workspace:*",
    "@embroidery/notification-delivery": "workspace:*",
    "@embroidery/object-storage": "workspace:*",
    "@embroidery/persistence": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "busboy": "1.6.0",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "^1.13.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/test-utils": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/busboy": "1.5.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
