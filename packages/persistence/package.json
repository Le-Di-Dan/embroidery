{
  "name": "@embroidery/persistence",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS persistence runtime, platform-primitive persistence and the shared AGG-15 Order / AGG-16 Payment persistence two applications write (DB7). Consumers: @embroidery/api, @embroidery/worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@embroidery/database": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
