{
  "name": "@embroidery/database",
  "version": "0.1.0",
  "private": true,
  "description": "Physical schema, migrations and persistence foundation (DB6)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx ./src/cli/migrate.ts",
    "db:status": "tsx ./src/cli/status.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "4.23.1",
    "typescript": "^5.9.3"
  }
}
