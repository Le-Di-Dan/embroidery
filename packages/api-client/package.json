{
  "name": "@embroidery/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized Axios client foundation for internal business API calls",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest && node --test \"scripts/*.test.mjs\"",
    "test:coverage": "jest --coverage",
    "generate": "node scripts/generate-client.mjs",
    "check:generated": "node scripts/check-generated-client.mjs"
  },
  "dependencies": {
    "@embroidery/contracts": "workspace:*",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "orval": "8.22.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
