    "/api/admin/assets/upload": {
      "post": {
        "description": "Streams a single PNG, JPEG or WebP image of at most 26214400 bytes into private storage and hands it to inspection. Idempotent: repeating the request with the same Idempotency-Key and the same file returns the original receipt and writes no second object.",
        "operationId": "adminAsset_upload",
        "parameters": [
          {
            "description": "8-128 characters of A-Z a-z 0-9 . _ : - identifying this upload attempt.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
