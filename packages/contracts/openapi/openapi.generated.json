            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "assetKind": {
                    "description": "Fixed. Must arrive before the file part.",
                    "enum": [
                      "CATALOG_MEDIA"
                    ],
                    "type": "string"
                  },
                  "classification": {
                    "description": "Fixed by policy and not client-selectable. Must arrive before the file part.",
                    "enum": [
                      "PRODUCTION_SENSITIVE"
                    ],
                    "type": "string"
                  },
                  "file": {
                    "description": "Exactly one PNG, JPEG or WebP image of at most 26214400 bytes.",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "assetKind",
                  "classification",
                  "file"
                ],
                "type": "object"
              }
            }
