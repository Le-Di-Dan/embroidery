{
  "name": "@embroidery/design-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent geometry and transformation logic for the Design Studio",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@embroidery/design-document": "workspace:*"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
