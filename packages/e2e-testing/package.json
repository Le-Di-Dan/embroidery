{
  "name": "@embroidery/e2e-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-application browser end-to-end suite (Playwright) — APP0-T02B",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "check:e2e": "node scripts/check-e2e.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:smoke": "node scripts/run-e2e.mjs --smoke",
    "e2e:full": "node scripts/run-e2e.mjs --full",
    "e2e:app1": "node scripts/run-e2e.mjs --app1",
    "e2e:app4": "node scripts/run-e2e.mjs --app4",
    "e2e:app4:browser": "node scripts/run-e2e.mjs --app4-browser",
    "e2e:app4:r01": "node scripts/run-e2e.mjs --app4-r01",
    "e2e:app4:r01c1": "node scripts/run-e2e.mjs --app4-r01-c1",
    "e2e:app5:e01": "node scripts/run-e2e.mjs --app5-e01",
    "e2e:app7:e01": "node scripts/run-e2e.mjs --app7-e01",
    "e2e:app12:s01": "node scripts/run-e2e.mjs --app12-s01",
    "e2e:app12:s02": "node scripts/run-e2e.mjs --app12-s02",
    "e2e:app12:s03": "node scripts/run-e2e.mjs --app12-s03",
    "e2e:app12:a01": "node scripts/run-e2e.mjs --app12-a01",
    "e2e:app12:a02": "node scripts/run-e2e.mjs --app12-a02",
    "e2e:app12:h06": "node scripts/run-e2e.mjs --app12-h06",
    "e2e:app12:h08": "node scripts/run-e2e.mjs --app12-h08",
    "e2e:app12:v01": "node scripts/run-e2e.mjs --app12-v01",
    "app7:e01:qr-scan-prepare": "node scripts/run-e2e.mjs --app7-qr-scan",
    "e2e:headed": "node scripts/run-e2e.mjs --headed",
    "e2e:debug": "node scripts/run-e2e.mjs --debug",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:install": "playwright install",
    "clean": "rimraf test-results playwright-report .e2e-state coverage",
    "e2e:app12:h01": "node scripts/run-e2e.mjs --app12-h01",
    "e2e:app12:h01:wave2": "node scripts/run-e2e.mjs --app12-h01-wave2"
  },
  "dependencies": {
    "@embroidery/database": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@embroidery/eslint-config": "workspace:*",
    "@embroidery/typescript-config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
